{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "JwtAuth": "Debug",
      "Microsoft": "Warning"
    }
  },

  "ReverseProxy": {
    "Routes": {
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/inventory/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/inventory" },
          { "RequestHeadersCopy": true }
        ]
      },
      "dashboard-inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/dashboard/inventory/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/dashboard/inventory" },
          { "PathPrefix": "/api/InventoryAnalytics" }
        ]
      },
      "sales-route": {
        "ClusterId": "sales-cluster",
        "Match": {
          "Path": "/sales/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeadersCopy": true },
          { "ResponseHeadersCopy": true },
          { "PathRemovePrefix": "/sales" }
        ]
      },
      "dashboard-sales-route": {
        "ClusterId": "sales-cluster",
        "Match": {
          "Path": "/dashboard/sales/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/dashboard/sales" },
          { "PathPrefix": "/api/SalesAnalytics" }
        ]
      },
      "purchase-route": {
        "ClusterId": "purchase-cluster",
        "Match": {
          "Path": "/purchase/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeadersCopy": true },
          { "ResponseHeadersCopy": true },
          { "PathRemovePrefix": "/purchase" }
        ]
      },

      "dashboard-purchase-route": {
        "ClusterId": "purchase-cluster",
        "Match": {
          "Path": "/dashboard/purchase/{**catch-all}"
        },
        "Transforms": [
          { "PathRemovePrefix": "/dashboard/purchase" },
          { "PathPrefix": "/api/PurchaseAnalytics" }
        ]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": {
          "Path": "/identity/{**catch-all}"
        },
        "Transforms": [
          { "RequestHeadersCopy": true },
          { "PathRemovePrefix": "/identity" }
        ]
      }


    },


    "Clusters": {
      "inventory-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:5009/"
          }
        }
      },

      "sales-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:5020/"
          }
        }
      },

      "purchase-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:5216/"
          }
        }
      },

      "identity-cluster": {
        "Destinations": {
          "dest1": {
            "Address": "http://localhost:5207/"
          }
        }
      }

    }
  },
  "Jwt": {
    "Key": "ThisIsASuperLongSecretKey_ForJWT_Authentication123!",
    "Issuer": "ERP.IdentityService",
    "Audience": "ERP.AllMicroservices"
  },


  "AllowedHosts": "*"
}
