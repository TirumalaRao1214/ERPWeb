@model PurchaseViewModel

<h2>Create Purchase</h2>

<form method="post">
    <table class="table">
        <thead>
            <tr>
                <th>ProductId</th>
                <th>Qty</th>
                <th>Price</th>
            </tr>
        </thead>

        <tbody>
            @for (int i = 0; i < Model.Items.Count; i++)
            {
                <tr>
                    <td>
                        <input class="form-control" asp-for="Items[i].ProductId" />
                    </td>
                    <td>
                        <input class="form-control" asp-for="Items[i].Qty" />
                    </td>
                    <td>
                        <input class="form-control" asp-for="Items[i].Price" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-success">Save Purchase</button>
</form>
