@{
    Layout = null;
}

@model LoginViewModel




<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>ERP Login</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        body {
            background: linear-gradient(135deg, #1f4e79, #2e7bbf);
            background-attachment: fixed;
            font-family: 'Segoe UI', sans-serif;
        }

        .login-wrapper {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .erp-card {
            width: 380px;
            padding: 35px;
            border-radius: 18px;
            background: rgba(255, 255, 255, 0.93);
            backdrop-filter: blur(6px);
            box-shadow: 0px 8px 25px rgba(0,0,0,0.15);
            animation: fadeIn 0.6s ease;
        }

        .erp-title {
            font-size: 1.6rem;
            font-weight: 700;
            color: #1f4e79;
            text-align: center;
            margin-bottom: 12px;
        }

        .erp-subtitle {
            font-size: 0.9rem;
            color: #6c757d;
            text-align: center;
            margin-bottom: 25px;
        }

        .form-control {
            border-radius: 10px;
            padding: 10px 12px;
        }

        .erp-btn {
            background: linear-gradient(90deg, #1f4e79, #2e7bbf);
            border: none;
            border-radius: 10px;
            padding: 10px;
            color: #fff;
            font-weight: 600;
            font-size: 1rem;
            transition: 0.2s;
        }

        .erp-btn:hover {
            opacity: 0.9;
            transform: translateY(-1px);
        }

       
    </style>
</head>

<body>

    <div class="login-wrapper">
        <div class="erp-card">

            <!-- ERP Branding -->
            <div class="erp-title">🧿 ERP System</div>
            <div class="erp-subtitle">Secure Login to Continue</div>

            <form method="post">
                <div class="mb-3">
                    <label asp-for="Username" class="form-label fw-semibold"></label>
                    <input asp-for="Username" class="form-control" placeholder="Enter your username">
                    <span class="text-danger small">@Html.ValidationMessageFor(m => m.Username)</span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label fw-semibold"></label>
                    <input asp-for="Password" type="password" class="form-control" placeholder="Enter your password">
                    <span class="text-danger small">@Html.ValidationMessageFor(m => m.Password)</span>
                </div>

                <button type="submit" class="erp-btn w-100 mt-2">
                    Login
                </button>

                <div class="mt-3 text-center text-danger">
                    @Html.ValidationSummary(false)
                </div>
            </form>

        </div>
    </div>

</body>
</html>
